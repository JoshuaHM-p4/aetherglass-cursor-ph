{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Excluded unfilled sketches, none of them imported anywhere:
  // - lib/oracle/tools.ts (Pane track): throw-only `execute` bodies break
  //   tool() generic inference; the errors vanish when the bodies are written.
  // - tools.ts (root): starter leftover per HANDOFF.md, references names that
  //   were never meant to resolve. The real file is lib/oracle/tools.ts.
  // Remove each from this list when it is filled.
  "exclude": [
    "node_modules",
    "lib/oracle/tools.ts",
    "tools.ts"
  ]
}
